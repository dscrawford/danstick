# Nix build result symlink, repointed by every `nix build`.
result
result-*

# mypy's cache is ~9MB and entirely reproducible.
.mypy_cache/

__pycache__/
*.py[cod]

# Renders and probe cores written by the preview/check tools.
*.png
*.so

# Rust build output and the cargo cache direnv points at.
rust/target/
.cargo-home/

# direnv's cached devShell profile.
.direnv/
.claude-flow/

# Agent tooling state: local sessions, swarm scratch, vector db.
.claude/
.swarm/
ruvector.db
