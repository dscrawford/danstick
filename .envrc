# direnv + nix-direnv: enter the flake's devShell on cd, and cache the result
# so it is not re-evaluated on every prompt.
#
# `nix develop` here evaluates the whole flake, which builds Pegasus. That is
# a one-off; nix-direnv keeps the profile alive afterwards. Without
# nix-direnv, `use flake` re-runs it every time and this is unusable.
if ! has nix_direnv_version || ! nix_direnv_version 3.0.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.6/direnvrc" "sha256-RYcUJaRMf8oF5LznDrlCXbkOQrywm0HDv1VjYGaJGdM="
fi

use flake

# The Python package lives under src/, not at the root.
PYTHONPATH="$PWD/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

# Keep cargo's registry and build cache out of the source tree, so a nix build
# of ./rust never has to copy one into the store.
export CARGO_HOME="$PWD/.cargo-home"
PATH_add "$PWD/tools"
